    t_val := (v0[3] - "NeuroPLC_Weights".w0[lo]) / ("NeuroPLC_Weights".w0[hi] - "NeuroPLC_Weights".w0[lo] + 1.0E-10);
    v3[0, 3] := "NeuroPLC_Weights".w1[150 + lo] * (1.0 - t_val) + "NeuroPLC_Weights".w1[150 + hi] * t_val;
